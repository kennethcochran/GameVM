{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "clean-test-results",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "clean"
      ]
    },
    {
      "name": "run-tests",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "test/GameVM.TestRunner"
      ]
    },
    {
      "name": "validate-docs",
      "group": "commit-msg",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".github/scripts/doc-sync-gate.csx",
        "--args",
        "${args}"
      ]
    }
  ]
}
