{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "args": [
        "-c",
        "export DOTNET_ROOT=$HOME/dotnet PATH=$HOME/.dotnet/tools:$HOME/dotnet:$PATH && nudge --sln GameVM.sln --baseline .nudge/baseline.txt"
      ],
      "command": "bash",
      "group": "pre-commit",
      "name": "nudge-coaching"
    },
    {
      "args": [
        "husky",
        "exec",
        ".github/scripts/doc-sync-gate.csx",
        "--args",
        "${args}"
      ],
      "command": "dotnet",
      "group": "commit-msg",
      "name": "validate-docs"
    }
  ]
}
