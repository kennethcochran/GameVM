{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "clean-test-results",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "clean"
      ]
    },
    {
      "name": "run-tests-with-coverage",
      "group": "pre-commit",
      "command": "dotnet-coverage",
      "args": [
        "collect",
        "dotnet run --project test/GameVM.TestRunner",
        "-f",
        "xml",
        "-o",
        "TestResults/coverage.xml"
      ]
    },
    {
      "name": "validate-crap-scores",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "tools/GameVM.CrapGate",
        "--",
        "TestResults/coverage.xml",
        "src",
        "30"
      ]
    },
    {
      "name": "validate-docs",
      "group": "commit-msg",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".github/scripts/doc-sync-gate.csx",
        "--args",
        "${args}"
      ]
    }
  ]
}
