{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "clean-test-results",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "clean"
      ]
    },
    {
      "name": "run-tests-with-coverage",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "test",
        "--collect:'XPlat Code Coverage'",
        "--results-directory:TestResults/crap-check"
      ]
    },
    {
      "name": "validate-crap-scores",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".husky/csx/crap-gate.csx",
        "--args",
        "TestResults/crap-check",
        "30"
      ]
    },
    {
      "name": "validate-docs",
      "group": "commit-msg",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".github/scripts/doc-sync-gate.csx",
        "--args",
        "${args}"
      ]
    }
  ]
}
